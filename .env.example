# -----------------------------------------------------------------------------
# Snaplnk environment variables. Copy to .env (local) and set the same keys in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server and are never
# shipped to the browser.
# -----------------------------------------------------------------------------

# --- Site --------------------------------------------------------------------
# Public origin used for short links, canonical URLs, sitemap and auth redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe in the browser; access is limited by row-level security).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row-level security. Used exclusively by admin code that has
# passed requireAdmin(), the /api/track pipeline and the sign-in role sync.
# Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin -------------------------------------------------------------------
# Comma-separated admin emails. An account becomes ADMIN on sign-in only if its
# email is listed here AND verified by the provider; removing an email demotes it.
ADMIN_EMAILS=
# Secret (32+ random characters) that signs the 7-day admin-session cookie.
# Generate: openssl rand -base64 48. Admin access is disabled while this is unset.
ADMIN_SESSION_SECRET=

# --- Analytics ---------------------------------------------------------------
# Secret (32+ random characters) for hashing IPs. Raw IPs are never stored: analytics
# use a SHA-256 with a salt derived from this + the UTC date (rotates daily), and link
# clicks use an HMAC of IP + user agent for unique-visitor counts.
ANALYTICS_SALT=

# --- Upstash Redis (rate limiting) -------------------------------------------
# Without these, rate limits fall back to a per-instance in-memory window.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudinary (QR code images) ---------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
